<!DOCTYPE html>
<html lang="so">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Wasaaradda Arrimaha Gudaha</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background: #f4f7fb;
      color: #222;
    }

    /* HEADER */
    header {
      background: #075e54;
      color: white;
      padding: 25px 15px;
      text-align: center;
    }

    header h1 {
      font-size: 25px;
      margin-bottom: 8px;
    }

    header p {
      font-size: 14px;
    }

    /* HOME */
    .hero {
      min-height: 70vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 30px 20px;
      background: white;
    }

    .hero-box {
      width: 100%;
      max-width: 650px;
    }

    .hero h2 {
      color: #075e54;
      font-size: 30px;
      line-height: 1.3;
      margin-bottom: 15px;
    }

    .hero p {
      color: #555;
      font-size: 17px;
      line-height: 1.6;
      margin-bottom: 25px;
    }

    .contact-button {
      display: inline-block;
      background: #075e54;
      color: white;
      text-decoration: none;
      padding: 14px 28px;
      border-radius: 8px;
      font-size: 16px;
      font-weight: bold;
    }

    .contact-button:hover {
      background: #064e46;
    }

    /* CONTACT */
    .container {
      width: 92%;
      max-width: 600px;
      margin: 30px auto;
    }

    .card {
      background: white;
      padding: 22px;
      border-radius: 12px;
      box-shadow: 0 3px 12px rgba(0,0,0,0.08);
      margin-bottom: 25px;
    }

    .card h2 {
      color: #075e54;
      margin-bottom: 18px;
      font-size: 22px;
    }

    label {
      display: block;
      margin: 15px 0 7px;
      font-weight: bold;
    }

    input,
    textarea {
      width: 100%;
      padding: 13px;
      border: 1px solid #ccc;
      border-radius: 8px;
      font-size: 15px;
      outline: none;
    }

    input:focus,
    textarea:focus {
      border-color: #075e54;
    }

    textarea {
      min-height: 120px;
      resize: vertical;
    }

    button {
      width: 100%;
      padding: 14px;
      margin-top: 20px;
      border: none;
      border-radius: 8px;
      background: #075e54;
      color: white;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
    }

    button:hover {
      background: #064e46;
    }

    .note {
      margin-top: 12px;
      font-size: 13px;
      color: #666;
      text-align: center;
      line-height: 1.5;
    }

    footer {
      text-align: center;
      padding: 25px;
      color: #777;
      font-size: 13px;
    }

    /* MOBILE */
    @media (max-width: 600px) {

      .hero h2 {
        font-size: 25px;
      }

      .hero p {
        font-size: 15px;
      }

      .card {
        padding: 18px;
      }

    }
  </style>
</head>

<body>

  <!-- HEADER -->
  <header>
    <h1>Wasaaradda Arrimaha Gudaha</h1>
    <p>Ku soo dhawoow adeegga xiriirka</p>
  </header>


  <!-- HOME -->
  <section class="hero">

    <div class="hero-box">

      <h2>
        Muwaadin, ma rabtaa inaad si fudud noola soo xidhiidho?
      </h2>

      <p>
        Fariintaada noo soo dir, waxaanan kula soo xidhiidhi doonaa
        marka aan helno.
      </p>

      <a href="#contact" class="contact-button">
        Nala Soo Xidhiidh
      </a>

    </div>

  </section>


  <!-- CONTACT FORM -->
  <section id="contact">

    <div class="container">

      <div class="card">

        <h2>Nala Soo Xidhiidh</h2>

        <form id="messageForm">

          <!-- EMAIL -->
          <label for="email">
            Email-kaaga
          </label>

          <input
            type="email"
            id="email"
            placeholder="Geli email-kaaga"
            required
          >


          <!-- MESSAGE 1 -->
          <label for="message1">
            Fariinta 1aad
          </label>

          <textarea
            id="message1"
            placeholder="Halkan ku qor fariinta koowaad..."
            required
          ></textarea>


          <!-- MESSAGE 2 -->
          <label for="message2">
            Fariinta 2aad
          </label>

          <textarea
            id="message2"
            placeholder="Halkan ku qor fariinta labaad..."
            required
          ></textarea>


          <!-- SEND -->
          <button type="submit">
            Send Message
          </button>

          <p class="note">
            Fadlan hubi in xogta iyo fariimaha aad gelisay ay sax yihiin
            ka hor intaadan dirin.
          </p>

        </form>

      </div>

    </div>

  </section>


  <!-- FOOTER -->
  <footer>
    © 2026 Wasaaradda Arrimaha Gudaha
  </footer>


  <script>

    document
      .getElementById("messageForm")
      .addEventListener("submit", function(event) {

        event.preventDefault();

        const email =
          document.getElementById("email").value;

        const message1 =
          document.getElementById("message1").value;

        const message2 =
          document.getElementById("message2").value;


        const subject =
          "Fariin cusub oo website-ka laga soo diray";


        const body =
          "Email-ka qofka: " + email +
          "\n\n" +
          "FARIINTA 1AAD:\n" +
          message1 +
          "\n\n" +
          "FARIINTA 2AAD:\n" +
          message2;


        /*
          MUHIIM:
          Halkaan ku beddel email-kaaga.
        */

        const myEmail =
          "YOUR-EMAIL@example.com";


        const mailto =
          "mailto:" + myEmail +
          "?subject=" +
          encodeURIComponent(subject) +
          "&body=" +
          encodeURIComponent(body);


        window.location.href = mailto;

      });

  </script>

</body>
</html>
